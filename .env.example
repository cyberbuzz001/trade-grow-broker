# PORT & SYSTEM CONFIGURATION
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_paper_trading_platform_2026
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_paper_trading_2026

# CRITICAL SAFETY SWITCH — DO NOT MODIFY
REAL_MONEY_TRADING=false

# DEFAULT VIRTUAL MONEY ALLOCATION (INR)
DEFAULT_VIRTUAL_CAPITAL=1000000

# ANGEL ONE SMARTAPI MARKET DATA PROVIDER CONFIGURATION (MARKET DATA ONLY)
ANGELONE_API_KEY=your_api_key
ANGELONE_CLIENT_ID=your_client_code
ANGELONE_CLIENT_SECRET=your_password
ANGELONE_TOTP_SECRET=your_totp_secret

SMARTAPI_API_KEY=your_api_key
SMARTAPI_CLIENT_CODE=your_client_code
SMARTAPI_PASSWORD=your_password
SMARTAPI_TOTP_SECRET=your_totp_secret

# INDIAN STOCK MARKET API CONFIGURATION (MARKET DATA ONLY)
INDIAN_STOCK_MARKET_API_BASE_URL=https://indian-stock-market-api.p.rapidapi.com

# ALPHA VANTAGE API CONFIGURATION (GLOBAL MARKET DATA & HISTORICAL CANDLES)
ALPHAVANTAGE_API_KEY=YOUR_ALPHAVANTAGE_API_KEY

# MARKET DATA PRIMARY PROVIDER [MOCK | ANGELONE | ALPHAVANTAGE | INDIAN_STOCK_MARKET_API]
PRIMARY_MARKET_DATA_PROVIDER=ANGELONE
